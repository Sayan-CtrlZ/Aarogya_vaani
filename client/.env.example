# ==============================================================================
# AAROGYAVAANI CLIENT (Vite + React) ENVIRONMENT CONFIGURATION
# Copy this file to .env before starting the development server:
# cp .env.example .env
# ==============================================================================

# Supabase Cloud Client Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# Standard aliases
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key_here

# FastAPI Backend REST API endpoint (default: port 8001)
VITE_API_URL=http://localhost:8001/api

# LiveKit Cloud WebRTC WebSocket URL (e.g., wss://your-subdomain.livekit.cloud)
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
