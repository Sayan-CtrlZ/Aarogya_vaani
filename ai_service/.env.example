# ==============================================================================
# AAROGYAVAANI AI SERVICE (LiveKit Voice Agent Worker) CONFIGURATION
# Copy this file to .env before starting the voice agent worker:
# cp .env.example .env
# ==============================================================================

# ==============================================================================
# LIVEKIT CLOUD (WebRTC Voice Session Infrastructure)
# Used for real-time audio rooms, patient audio streaming, and voice agent dispatch
# Get credentials from LiveKit Cloud: https://cloud.livekit.io/
# ==============================================================================
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# ==============================================================================
# SARVAM AI (Primary Indic Speech: STT & TTS)
# Primary Speech-to-Text (STT) and Text-to-Speech (TTS) for Indian languages
# Powers Bengali (bn-IN), Hindi (hi-IN), and English (en-IN) Bulbul v3 voices
# Get your API key from Sarvam Dashboard: https://dashboard.sarvam.ai/
# ==============================================================================
SARVAM_API_KEY=your_sarvam_api_key_here

# ==============================================================================
# GROQ CLOUD (Primary Fast LLM Reasoning Engine)
# High-speed LLM inference (e.g., openai/gpt-oss-120b or llama-3.3-70b-versatile)
# used for patient dialogue, clinical intake question elicitation, and language locking
# Get your API key from Groq Console: https://console.groq.com/keys
# ==============================================================================
OPENAI_API_KEY=your_groq_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ==============================================================================
# GOOGLE GEMINI (Multi-Modal Vision & Medical Document Analysis)
# Get your API key from Google AI Studio: https://aistudio.google.com/
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# ANTHROPIC CLAUDE (Fallback / Alternative LLM) - OPTIONAL
# Secondary LLM provider for advanced clinical reasoning
# Get your API key from Anthropic Console: https://console.anthropic.com/
# ==============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==============================================================================
# ASSEMBLYAI (Fallback STT Provider) - OPTIONAL
# Backup Speech-to-Text engine if primary Sarvam STT experiences downtime
# ==============================================================================
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# ==============================================================================
# CARTESIA (Fallback TTS Provider) - OPTIONAL
# Backup low-latency Text-to-Speech engine for English audio output
# ==============================================================================
CARTESIA_API_KEY=your_cartesia_api_key_here

# ==============================================================================
# SUPABASE CLOUD (Database, Auth, Storage & Realtime)
# Get credentials from Supabase Dashboard > Project Settings > API:
# https://supabase.com/dashboard/project/<ref>/settings/api
# ==============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
